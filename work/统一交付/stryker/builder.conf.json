{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "out/test/*.test.js"
    ],
    "forceBail": false
  },
  "mutate": [
    "out/openapi/builder.js"
  ],
  "inPlace": true,
  "ignorePatterns": [
    ".probe",
    "reports",
    ".stryker-tmp"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/per-file/builder.json"
  },
  "timeoutMS": 30000,
  "timeoutFactor": 2,
  "concurrency": 4,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "disableTypeChecks": false
}