{
  "name": "api2apifox",
  "displayName": "ApiGen for Apifox",
  "description": "零配置、全自动将 Java 项目 Controller/OpenAPI 接口同步至 Apifox,全功能替代 IntelliJ Apifox Helper 插件",
  "version": "0.2.18",
  "publisher": "duyiliu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/duyiliu/apifox-helper-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "apifox",
    "spring",
    "spring boot",
    "openapi",
    "swagger",
    "api doc"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apifoxHelper.openSettingsPanel",
        "title": "ApiGen for Apifox: 项目与账号设置中心 (Settings)",
        "icon": "$(gear)"
      },
      {
        "command": "apifoxHelper.setToken",
        "title": "ApiGen for Apifox: 设置访问令牌 (Access Token)",
        "icon": "$(key)"
      },
      {
        "command": "apifoxHelper.clearToken",
        "title": "ApiGen for Apifox: 清除访问令牌 (Clear Token)",
        "icon": "$(trash)"
      },
      {
        "command": "apifoxHelper.selectProject",
        "title": "ApiGen for Apifox: 选择 Apifox 项目 (Select Project)",
        "icon": "$(project)"
      },
      {
        "command": "apifoxHelper.syncWorkspace",
        "title": "ApiGen for Apifox: 同步整个项目到 Apifox (Sync Workspace)"
      },
      {
        "command": "apifoxHelper.syncFile",
        "title": "ApiGen for Apifox: 同步当前文件到 Apifox (Sync This File)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "apifoxHelper.syncMethod",
        "title": "ApiGen for Apifox: 同步光标处接口到 Apifox (Sync This Endpoint)"
      },
      {
        "command": "apifoxHelper.exportOpenapi",
        "title": "ApiGen for Apifox: 导出 OpenAPI 预览文件 (Export openapi.gen.json)"
      },
      {
        "command": "apifoxHelper.refreshApiTree",
        "title": "ApiGen for Apifox: 刷新接口列表 (Refresh API List)",
        "icon": "$(refresh)"
      },
      {
        "command": "apifoxHelper.filterApi",
        "title": "ApiGen for Apifox: 过滤接口列表 (Filter API List)",
        "icon": "$(filter)"
      },
      {
        "command": "apifoxHelper.clearFilter",
        "title": "ApiGen for Apifox: 清除接口过滤 (Clear API Filter)",
        "icon": "$(filter-remove)"
      },
      {
        "command": "apifoxHelper.searchApi",
        "title": "ApiGen for Apifox: 搜索接口 (Search API)",
        "icon": "$(search)"
      },
      {
        "command": "apifoxHelper.checkAllApis",
        "title": "ApiGen for Apifox: 全选所有接口 (Check All)",
        "icon": "$(check-all)"
      },
      {
        "command": "apifoxHelper.uncheckAllApis",
        "title": "ApiGen for Apifox: 清空所有勾选 (Clear Checks)",
        "icon": "$(clear-all)"
      },
      {
        "command": "apifoxHelper.syncFolderApis",
        "title": "ApiGen for Apifox: 同步此目录全部接口到 Apifox",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "apifoxHelper.checkFolderApis",
        "title": "ApiGen for Apifox: 勾选本目录全部接口",
        "icon": "$(check)"
      },
      {
        "command": "apifoxHelper.uncheckFolderApis",
        "title": "ApiGen for Apifox: 取消勾选本目录接口",
        "icon": "$(close)"
      },
      {
        "command": "apifoxHelper.syncCheckedApis",
        "title": "ApiGen for Apifox: 同步勾选的接口到 Apifox (Sync Checked APIs)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "apifoxHelper.gotoEndpoint",
        "title": "ApiGen for Apifox: 跳转到接口定义 (Goto Definition)"
      },
      {
        "command": "apifoxHelper.syncEndpoint",
        "title": "ApiGen for Apifox: 同步此接口到 Apifox",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "apifoxHelper.copyEndpointPath",
        "title": "ApiGen for Apifox: 复制接口路径 (Copy Path)",
        "icon": "$(copy)"
      },
      {
        "command": "apifoxHelper.copyEndpointFull",
        "title": "ApiGen for Apifox: 复制完整接口 (Copy Method & Path)",
        "icon": "$(clippy)"
      },
      {
        "command": "apifoxHelper.showStatusBarMenu",
        "title": "ApiGen for Apifox: 快捷操作菜单 (Status Bar Menu)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apifoxHelper",
          "title": "ApiGen for Apifox",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "apifoxHelper": [
        {
          "id": "apifoxHelper.apiTree",
          "name": "接口列表"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apifoxHelper.apiTree",
        "contents": "尚未配置 Apifox 访问令牌或项目。\n[⚙ 打开设置中心](command:apifoxHelper.openSettingsPanel)\n\n若已配置，请确保工作区包含 Spring Boot Controller 源码，点击下方刷新接口：\n[🔄 刷新接口列表](command:apifoxHelper.refreshApiTree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apifoxHelper.openSettingsPanel",
          "group": "navigation@0",
          "when": "view == apifoxHelper.apiTree"
        },
        {
          "command": "apifoxHelper.syncCheckedApis",
          "group": "navigation@1",
          "when": "view == apifoxHelper.apiTree"
        },
        {
          "command": "apifoxHelper.checkAllApis",
          "group": "navigation@2",
          "when": "view == apifoxHelper.apiTree"
        },
        {
          "command": "apifoxHelper.uncheckAllApis",
          "group": "navigation@3",
          "when": "view == apifoxHelper.apiTree"
        },
        {
          "command": "apifoxHelper.filterApi",
          "group": "navigation@4",
          "when": "view == apifoxHelper.apiTree"
        },
        {
          "command": "apifoxHelper.clearFilter",
          "group": "navigation@4.1",
          "when": "view == apifoxHelper.apiTree && apifoxHelper.isFiltered"
        },
        {
          "command": "apifoxHelper.searchApi",
          "group": "navigation@5",
          "when": "view == apifoxHelper.apiTree"
        },
        {
          "command": "apifoxHelper.refreshApiTree",
          "group": "navigation@6",
          "when": "view == apifoxHelper.apiTree"
        }
      ],
      "view/item/context": [
        {
          "command": "apifoxHelper.clearFilter",
          "group": "inline",
          "when": "view == apifoxHelper.apiTree && viewItem == filterBar"
        },
        {
          "command": "apifoxHelper.filterApi",
          "group": "1_filter@1",
          "when": "view == apifoxHelper.apiTree && viewItem == filterBar"
        },
        {
          "command": "apifoxHelper.clearFilter",
          "group": "1_filter@2",
          "when": "view == apifoxHelper.apiTree && viewItem == filterBar"
        },
        {
          "command": "apifoxHelper.syncFolderApis",
          "group": "inline",
          "when": "view == apifoxHelper.apiTree && viewItem == folder"
        },
        {
          "command": "apifoxHelper.syncFolderApis",
          "group": "1_sync@1",
          "when": "view == apifoxHelper.apiTree && viewItem == folder"
        },
        {
          "command": "apifoxHelper.checkFolderApis",
          "group": "2_check@1",
          "when": "view == apifoxHelper.apiTree && viewItem == folder"
        },
        {
          "command": "apifoxHelper.uncheckFolderApis",
          "group": "2_check@2",
          "when": "view == apifoxHelper.apiTree && viewItem == folder"
        },
        {
          "command": "apifoxHelper.syncEndpoint",
          "group": "inline",
          "when": "view == apifoxHelper.apiTree && viewItem == endpoint"
        },
        {
          "command": "apifoxHelper.syncEndpoint",
          "group": "1_sync@1",
          "when": "view == apifoxHelper.apiTree && viewItem == endpoint"
        },
        {
          "command": "apifoxHelper.gotoEndpoint",
          "group": "1_sync@2",
          "when": "view == apifoxHelper.apiTree && viewItem == endpoint"
        },
        {
          "command": "apifoxHelper.copyEndpointPath",
          "group": "2_copy@1",
          "when": "view == apifoxHelper.apiTree && viewItem == endpoint"
        },
        {
          "command": "apifoxHelper.copyEndpointFull",
          "group": "2_copy@2",
          "when": "view == apifoxHelper.apiTree && viewItem == endpoint"
        }
      ],
      "editor/title": [
        {
          "command": "apifoxHelper.syncFile",
          "when": "resourceLangId == java",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "apifoxHelper.syncFile",
          "when": "resourceLangId == java",
          "group": "apifox@1"
        }
      ],
      "editor/context": [
        {
          "command": "apifoxHelper.syncFile",
          "when": "resourceLangId == java",
          "group": "apifox@1"
        }
      ]
    },
    "configuration": {
      "title": "ApiGen for Apifox",
      "properties": {
        "apifoxHelper.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "是否在 Java Controller 方法上方显示「同步此接口」的 CodeLens 快捷按钮。"
        },
        "apifoxHelper.projectId": {
          "type": "number",
          "default": 0,
          "description": "Apifox 项目 ID(可用命令「选择 Apifox 项目」自动获取)。项目设置页可查看。"
        },
        "apifoxHelper.projectName": {
          "type": "string",
          "default": "",
          "description": "当前选择绑定的 Apifox 项目名称(选择项目时自动记录)。"
        },
        "apifoxHelper.teamName": {
          "type": "string",
          "default": "",
          "description": "当前选择绑定的 Apifox 项目所属团队名称(选择项目时自动记录)。"
        },
        "apifoxHelper.apiBaseUrl": {
          "type": "string",
          "default": "https://api.apifox.com",
          "description": "Apifox 开放 API 地址,私有化部署时可替换。"
        },
        "apifoxHelper.endpointConflictBehavior": {
          "type": "string",
          "enum": [
            "OVERWRITE_EXISTING",
            "AUTO_MERGE",
            "KEEP_EXISTING",
            "CREATE_NEW"
          ],
          "default": "OVERWRITE_EXISTING",
          "enumDescriptions": [
            "覆盖已有接口",
            "自动合并",
            "保留现有(跳过)",
            "创建新接口"
          ],
          "description": "同步时接口(Endpoint)冲突处理方式。"
        },
        "apifoxHelper.schemaConflictBehavior": {
          "type": "string",
          "enum": [
            "OVERWRITE_EXISTING",
            "AUTO_MERGE",
            "KEEP_EXISTING",
            "CREATE_NEW"
          ],
          "default": "OVERWRITE_EXISTING",
          "enumDescriptions": [
            "覆盖已有数据模型",
            "自动合并",
            "保留现有(跳过)",
            "创建新数据模型"
          ],
          "description": "同步时数据模型(Schema)冲突处理方式。"
        },
        "apifoxHelper.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/src/main/java/**/*.java"
          ],
          "description": "扫描的 Java 文件 glob。"
        },
        "apifoxHelper.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/target/**",
            "**/build/**",
            "**/src/test/**",
            "**/sample/**"
          ],
          "description": "排除的 glob。"
        },
        "apifoxHelper.exportPath": {
          "type": "string",
          "default": "openapi.gen.json",
          "description": "「导出 OpenAPI 预览」输出文件(相对工作区根目录)。"
        },
        "apifoxHelper.pageTypeStyle": {
          "type": "string",
          "enum": [
            "mybatis-plus",
            "spring-data"
          ],
          "default": "mybatis-plus",
          "enumDescriptions": [
            "MyBatis-Plus 形态(records/total/size/current/pages),适用于 Page/IPage",
            "Spring Data 形态(content/totalElements/totalPages/number/size),适用于 Page/PageImpl/Slice"
          ],
          "description": "简单名为 Page 的分页包装按哪个库的形态展开;PageInfo 恒为 PageHelper 形态。"
        },
        "apifoxHelper.folderNameSource": {
          "type": "string",
          "enum": [
            "tag",
            "controller"
          ],
          "default": "tag",
          "description": "接口目录命名来源:@Tag 注解值(缺省类名)或 Controller 类名。"
        },
        "apifoxHelper.rootFolderName": {
          "type": "string",
          "default": "",
          "description": "可选。所有接口目录放到该父目录下(不存在则自动创建),留空则直接放在项目根。"
        },
        "apifoxHelper.schemaFolderId": {
          "type": "number",
          "default": 0,
          "description": "可选。数据模型导入到该目录(填 Apifox 中目录的数字 ID,可在客户端目录右键复制),0 或留空则放在模型根目录。"
        },
        "apifoxHelper.schemaFolderName": {
          "type": "string",
          "default": "",
          "description": "已废弃(Apifox 开放 API 已下线目录查询接口,无法按名查找)。请改用 apifoxHelper.schemaFolderId。"
        },
        "apifoxHelper.helperProperties.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否识别工作区中的 .apifox-helper.properties(与 IDEA 版 Apifox Helper 兼容的规则子集)。"
        },
        "apifoxHelper.helperProperties.enumFieldDoc": {
          "type": "boolean",
          "default": false,
          "description": "字段类型为枚举时,自动在字段描述后追加「(枚举类:类名)」。对应团队 groovy 规则意图,默认关。"
        },
        "apifoxHelper.dependencyRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "可选兜底:额外本地 Maven 仓库目录。默认已自动发现(JetBrains MAVEN_REPOSITORY 路径变量、IDEA Maven 索引、~/.m2/settings.xml、~/.m2/repository),仅当自动发现不到时才需要配置。"
        },
        "apifoxHelper.dependencyJars": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "显式依赖 jar 的绝对路径(优先于仓库发现),用于识别源码之外的类型。"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test out/test/utils.test.js out/test/analyze.test.js out/test/features.test.js out/test/properties.test.js out/test/rules.test.js out/test/jar.test.js out/test/treeFilter.test.js",
    "package": "npm run typecheck && npm run compile && npx @vscode/vsce package --no-dependencies -o apifox-helper-vscode.vsix",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "watch": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "java-parser": "^2.1.1"
  }
}
